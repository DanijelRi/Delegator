# Connection string iz Neon konzole (Connect → pooled)
DATABASE_URL=
# Kod za prvo postavljanje: prvi korisnik ga upisuje i postaje administrator
APP_PASSWORD=
# Koliko AI brzih unosa dnevno smije svaki korisnik (zadano 40)
# AI_DAILY_LIMIT=40
# Samo lokalno, za brzi unos uz AI (na Vercelu se koristi VERCEL_OIDC_TOKEN)
AI_GATEWAY_API_KEY=
# AI_GATEWAY_MODEL=anthropic/claude-haiku-5.5
# Push obavijesti (Web Push): ključevi se generiraju s
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Tajna za noćni posao /api/cron (Vercel Cron je šalje kao Authorization: Bearer …)
CRON_SECRET=
